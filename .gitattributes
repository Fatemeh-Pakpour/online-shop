# Normalize all text files to LF in the repository and in the working tree.
# Keeps Prettier's default endOfLine: "lf" passing on Windows checkouts.
* text=auto eol=lf

# Generated by pnpm — collapse diffs in reviews.
pnpm-lock.yaml linguist-generated=true

# Never touch binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
